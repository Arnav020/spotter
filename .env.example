# Nebius Token Factory API key (https://tokenfactory.nebius.com/project/api-keys)
NEBIUS_API_KEY=
# Tavily API key (https://app.tavily.com) - used to ground custom procedures in real sources
TAVILY_API_KEY=

# Optional overrides
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# SPOTTER_PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# SPOTTER_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# SPOTTER_CONTROLLER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Daily demo caps (per server instance)
# LIMIT_OBSERVE_PER_IP=400
# LIMIT_OBSERVE_GLOBAL=3000
# Local UI development without credits (never set in production)
# SPOTTER_MOCK=1
